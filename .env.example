# Copy this file to .env for local development, and set the same keys as
# environment variables on your Vercel project (Settings → Environment
# Variables). Frontend and backend deploy together as one Vercel project —
# these are NOT set anywhere else (no separate Render service anymore).

# Resend (existing — contact form emails)
RESEND_API_KEY=
RESEND_FROM=
TO_EMAIL=

# Postgres connection string (Supabase / Neon / any Postgres host).
# Powers the admin dashboard: stored form submissions + live chat history.
# Prefer a "pooled" connection string (Supabase's Transaction pooler, Neon's
# pooled endpoint) — serverless functions open many short-lived connections,
# and a pooler avoids exhausting your database's connection limit.
# Leave unset to keep the site running without these features (contact form
# still emails via Resend; the live chat widget shows a graceful "unavailable" message).
DATABASE_URL=

# Admin dashboard login (visit /admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Signs admin session tokens. IMPORTANT on serverless: without this set, a
# random secret is generated on every cold start, which signs everyone out
# far more often than on a traditional always-on server. Set a long random
# string here — e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=

# Optional: verifies that /api/cron/refresh-reviews is really being called by
# Vercel Cron and not some random request. Set any random string here, and
# Vercel automatically sends it as a Bearer token to your cron routes.
CRON_SECRET=

# Google Reviews (existing — all optional, sensible defaults are baked in)
GOOGLE_REVIEWS_CACHE_TTL_HOURS=24
GOOGLE_REVIEWS_WIDGET_ID=
GOOGLE_REVIEWS_PAGE_URL=
GOOGLE_REVIEWS_PROFILE_URL=
